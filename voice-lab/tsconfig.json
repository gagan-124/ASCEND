{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "typeRoots": [
      "../node_modules/@types",
      "../frontend/node_modules/@types"
    ],
    "types": ["node"]
  },
  "include": [
    "**/*.ts"
  ]
}
